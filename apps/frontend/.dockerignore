# Dependencies (prevents overwriting npm ci in container & saves 1.3GB context)
node_modules/

# Production build output
dist/

# Environment files (prevent baking secrets into static assets)
.env
.env.*
!.env.example

# Testing & Coverage
coverage/
.vitest/

# Test source files — not needed in Docker build context (dev container reads
# these from the host bind-mount at runtime, not from the image layer)
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# Tooling config — only used outside Docker (CI, local dev scripts)
vitest.config.*
vitest.setup.*
knip.config.*
.eslintrc*
.eslintignore
eslint.config.*

# Extra tsconfig variants (base tsconfig.json is needed for the build, and it
# references tsconfig.node.json, so that one must stay in the context)
tsconfig.*.json
!tsconfig.node.json

# Git & Repository metadata
.git/
.gitignore

# System & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Storybook (excluded proactively if added later)
.storybook/
**/*.stories.*
**/*.stories.ts
**/*.stories.tsx
