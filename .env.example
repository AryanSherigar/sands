# ==============================================================================
# Sands Local Docker & Environment Configuration Template
# Copy this file to .env before starting Docker Compose services:
#   cp .env.example .env
#
# NOTE: The credentials below (e.g. POSTGRES_PASSWORD, SECRET_KEY) are default
# placeholders intended ONLY for isolated local development.
# DO NOT use these default values in staging or production environments!
# ==============================================================================

# --- PostgreSQL Database Configuration ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sands_db
POSTGRES_PORT=5432

# --- Core API Configuration ---
CORE_API_PORT=8000
CORE_API_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/sands_db
SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_CREDENTIALS_PATH=
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80"]
ENVIRONMENT=development
LOG_LEVEL=INFO
# Object storage: Cloudflare R2 (S3 API). Leave empty in development to write
# uploads to local disk; required when ENVIRONMENT=production.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
CORE_API_PUBLIC_URL=http://localhost:8000

# --- Turn Resolution Service Configuration ---
TRS_PORT=8001
TRS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/sands_db
# Vertex AI key used only for narration text-to-speech (Gemini TTS) and Core API
# music generation. Narration, images and voice input use MUSE_API_KEY below.
# Get a key at https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY=your_gemini_api_key_here
# Memory service (apps/memory). core-api and turn-resolution-service both read
# MEMORY_URL: TRS for retrieve and ingest, core-api to build a scenario's
# template at publish and to purge. Dev auth only: each sends its service name.
MEMORY_URL=http://localhost:8080
# Shared secret between the memory-sweep sidecar and TRS's POST
# /internal/memory/relay. Empty disables that endpoint, so memory delivery then
# relies on the inline attempt after each turn only. docker-compose.yml falls
# back to a dev value when this is unset; set a real secret outside local dev.
INTERNAL_SERVICE_TOKEN=dev-internal-service-token-change-me
# Seconds between sweeps of the memory outbox relay and memory's process-pending.
SWEEP_INTERVAL_SECONDS=60
LOG_LEVEL=INFO

# --- Meta Muse (narration, images, speech-to-text, memory extraction) ---
# TRS narration calls Meta Muse Spark over OpenAI-compatible Chat Completions.
# MUSE_API_KEY is the single key used by TRS, Core API and memory.
# NARRATION_PROVIDER=anthropic switches narration to Claude instead.
NARRATION_PROVIDER=openai
MUSE_API_KEY=your_muse_api_key_here
MUSE_BASE_URL=https://api.meta.ai/v1
OPENAI_COMPATIBLE_BASE_URL=https://api.meta.ai/v1
OPENAI_COMPATIBLE_MODEL_NAME=muse-spark-1.3
# Muse Spark always reasons; "minimal" is the lowest accepted value ("none" is a 400).
OPENAI_COMPATIBLE_REASONING_EFFORT=minimal
MUSE_IMAGE_MODEL_NAME=muse-image-1.0
MUSE_VOICE_MODEL_NAME=muse-voice-transcribe-1.0
# Memory extraction runs on Muse Spark (embeddings stay on Vertex).
# EXTRACTION_PROVIDER=anthropic is also supported.
EXTRACTION_PROVIDER=muse

# --- Voice ---
# Voice input runs on Muse Voice Transcribe (MUSE_API_KEY above). The service account
# below is used only for Gemini TTS voice output when SHOULD_USE_SERVICE_ACCOUNT_FOR_TTS=true.
SPEECH_TO_TEXT_CREDENTIALS_PATH=
SPEECH_TO_TEXT_PROJECT_ID=your_gcp_project_id_here
# Voice output (Gemini TTS): false = GEMINI_API_KEY (Express Mode); true = the
# service account above via Vertex AI (needs roles/aiplatform.user on the project).
SHOULD_USE_SERVICE_ACCOUNT_FOR_TTS=false
TEXT_TO_SPEECH_LOCATION=global

# --- Memory Service Configuration ---
# apps/memory: own Postgres database (memory_db), kept separate from sands_db,
# migrated independently by the memory-migrate service.
# Seconds between runs of the Core maintenance loop (outbox prune + orphan
# reconcile dry-run).
MAINTENANCE_INTERVAL_SECONDS=86400
# Vertex AI key for the memory service's embedding calls (Muse has no embeddings)
# -- independent of TRS's GEMINI_API_KEY above (separate service, separate quota),
# though both may point at the same Google Cloud project. Extraction uses MUSE_API_KEY.
# Get a key at https://ai.google.dev/gemini-api/docs/api-key
GOOGLE_CLOUD_API_KEY=your_gemini_api_key_here

# --- Frontend Configuration ---
FRONTEND_PORT=5173
# Baked into the production build as the base URL the frontend calls for the
# API and for TRS. Defaults to same-origin paths routed by the frontend's own
# nginx reverse proxy (see apps/frontend/nginx.conf) -- do NOT set these to an
# absolute http://localhost URL, that value gets compiled into the bundle
# and breaks every deployment except your own machine (see docker-compose.yml
# CRIT-01). Local dev (docker-compose.dev.yml) hardcodes its own absolute
# localhost URLs directly and ignores these two.
VITE_CORE_API_URL=/api
VITE_TRS_URL=/trs
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
VITE_MEASUREMENT_ID=your_measurement_id_here

# Tallis welcome tape (TRS only)
FISH_API_KEY=
FISH_TTS_MODEL=s2.1-pro-free
FISH_KATIE_VOICE_ID=ecc977e5dca94390926fab1e0c2ba292
FISH_TIMEOUT_SECONDS=12

# --- Strategy mode (simulation) ---
# core-api and TRS reach the simulation over HTTP and authenticate with
# INTERNAL_SERVICE_TOKEN (above). docker-compose.yml wires SIMULATION_URL and
# SIMULATION_INTERNAL_TOKEN for you; set these only when running outside compose.
SIMULATION_URL=http://localhost:8081
SIMULATION_INTERNAL_TOKEN=dev-internal-service-token-change-me
# Stance, intent and battle-speech grading call Meta Muse Spark over Chat
# Completions. Disabled means the deterministic default is used. MUSE_API_KEY
# (above) is the key; copy it into each *_PROVIDER_API_KEY.
LLM_PROVIDER_PROTOCOL=chat_completions
# "minimal" is the lowest value Muse accepts; leave empty for other providers.
LLM_PROVIDER_REASONING_EFFORT=minimal
STANCE_PROVIDER_ENABLED=true
STANCE_PROVIDER_URL=https://api.meta.ai/v1/chat/completions
STANCE_PROVIDER_API_KEY=your_muse_api_key_here
STANCE_PROVIDER_MODEL=muse-spark-1.3
# Intent stays off: Muse takes 1.7 to 2.7 s here and the intent timeout is capped at 2 s,
# so answers would arrive late and the deterministic fallback would win anyway.
INTENT_PROVIDER_ENABLED=false
INTENT_PROVIDER_URL=https://api.meta.ai/v1/chat/completions
INTENT_PROVIDER_API_KEY=your_muse_api_key_here
INTENT_PROVIDER_MODEL=muse-spark-1.3
SPEECH_PROVIDER_ENABLED=true
SPEECH_PROVIDER_URL=https://api.meta.ai/v1/chat/completions
SPEECH_PROVIDER_API_KEY=your_muse_api_key_here
SPEECH_PROVIDER_MODEL=muse-spark-1.3
